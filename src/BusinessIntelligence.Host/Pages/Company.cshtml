@page "/firma/{cui:long?}"
@model CompanyModel
@using BusinessIntelligence.Modules.Financials
@{
    var profile = Model.Profile;
    var company = profile.Company;
    var current = profile.CurrentRegistration;
    var fiscal = profile.LatestFiscal;
    var ro = CompanyModel.Ro;
    ViewData["Title"] = company.Name ?? company.RegistrationNumber;
    var filed = profile.Financials.Where(year => year.Statement is not null).ToList();
    var latestStatement = filed.LastOrDefault();
    var fiscalEdition = fiscal is not null && profile.FiscalSource is { } fiscalNote ? fiscalNote with { Period = "ediția " + CompanyModel.Date(fiscal.ValidTo) } : null;
    var peopleSource = profile.RegistrySource with { Dataset = profile.RegistrySource.Dataset + " (reprezentanți)" };
    var websiteSource = profile.RegistrySource with { Dataset = profile.RegistrySource.Dataset + " (site web)" };
}

<header class="profile-header">
    <p class="md-typescale-label-large md-on-surface-variant">@(company.LegalForm ?? "Formă juridică necunoscută")</p>
    <h1 class="md-typescale-headline-medium profile-header__name">@(company.Name ?? "Fără denumire")</h1>
    <div class="cluster">
        <span class="md-status md-status--@company.Lifecycle.ToLowerInvariant()">@Model.Lifecycle(company.Lifecycle)</span>
        @if (company.Cui is not null) { <span class="md-typescale-body-medium">CUI <span class="md-numeric">@company.Cui</span></span> }
        <span class="md-typescale-body-medium">@company.RegistrationNumber</span>
        @if (Model.County(company.CountyNumber) is { } county) { <span class="md-typescale-body-medium md-on-surface-variant">@(Model.Place(company.LocalityCode ?? company.UatCode) is { } place ? $"{place}, " : "")@county</span> }
    </div>
</header>

<nav class="md-tabs profile-nav" aria-label="Secțiuni">
    <a class="md-tab" href="#prezentare">Prezentare</a>
    @if (profile.RiskBuild is not null) { <a class="md-tab" href="#semnale">Semnale</a> }
    <a class="md-tab" href="#contact">Contact</a>
    @if (profile.Anaf is not null) { <a class="md-tab" href="#anaf">ANAF</a> }
    <a class="md-tab" href="#persoane">Persoane</a>
    <a class="md-tab" href="#activitati">Activități</a>
    @if (profile.Procurement is not null) { <a class="md-tab" href="#achizitii">Achiziții publice</a> }
    @if (profile.FundSources.Count > 0) { <a class="md-tab" href="#fonduri">Fonduri UE</a> }
    @if (profile.Licences.Count > 0) { <a class="md-tab" href="#licente">Licențe</a> }
    <a class="md-tab" href="#istoric">Istoric</a>
    <a class="md-tab" href="#financiar">Financiar</a>
</nav>

<div class="profile-sections">
<section id="prezentare" class="md-card md-card--outlined profile-section" aria-labelledby="prezentare-title">
    <h2 id="prezentare-title" class="md-card__title">Prezentare</h2>
    <dl class="md-facts">
        <div><dt>CUI</dt><dd>@(company.Cui?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "fără CUI valid în registru")</dd></div>
        <div><dt>Nr. înregistrare</dt><dd>@company.RegistrationNumber</dd></div>
        @if (current?.Euid is { } euid) { <div><dt>EUID</dt><dd>@euid</dd></div> }
        <div><dt>Formă juridică</dt><dd>@(company.LegalForm ?? "—")</dd></div>
        <div><dt>Înregistrată</dt><dd>@(CompanyModel.Date(company.FirstRegistrationDate ?? company.RegistrationDate) is { Length: > 0 } date ? date : "—")</dd></div>
        <div><dt>Stare ONRC</dt><dd>@Model.Lifecycle(company.Lifecycle)@if (profile.Statuses.Count > 0) {<span class="md-on-surface-variant"> (@string.Join(", ", profile.Statuses.Where(item => item.RegistrationNumber == company.RegistrationNumber).Select(item => item.Name)))</span>}</dd></div>
        <div class="md-facts__wide"><dt>Sediu social</dt><dd>@AddressText(current)</dd></div>
        @if (current?.ParentCountry is { } parent) { <div><dt>Țara firmei-mamă</dt><dd>@parent</dd></div> }
        @if (fiscal is not null)
        {
            <div><dt>Plătitor de TVA</dt><dd>@(fiscal.VatPayer switch { true => "Da" + (fiscal.VatSince is { } since ? $", din {CompanyModel.Date(since)}" : ""), false => "Nu", null => "nedeclarat" })</dd></div>
            <div><dt>Stare fiscală</dt><dd>@(fiscal.FiscalStatus ?? "—")@if (fiscal.StatusDate is { } statusDate) {<span class="md-on-surface-variant">, @CompanyModel.Date(statusDate)</span>}</dd></div>
        }
        @if (profile.Registrations.Count > 1)
        {
            var others = profile.Registrations.Skip(1).ToList();
            var differentNames = others.Where(item => BusinessIntelligence.Modules.Search.SearchKeys.Name(item.Name) != BusinessIntelligence.Modules.Search.SearchKeys.Name(company.Name)).ToList();
            <div class="md-facts__wide"><dt>Alte înregistrări cu același CUI</dt><dd>@string.Join("; ", others.Select(item => item.RegistrationNumber
                + (differentNames.Contains(item) ? $" „{item.Name}”" : "") + (item.Lifecycle == company.Lifecycle ? "" : $" ({Model.Lifecycle(item.Lifecycle)})")))</dd></div>
            @if (differentNames.Count > 0)
            {
                <div class="md-facts__wide notice" role="note">Registrul atribuie acest CUI și unei înregistrări cu altă denumire. Legătura poate fi o eroare a sursei; datele fiscale și financiare de mai jos sunt cele ale CUI-ului.</div>
            }
        }
    </dl>
    @if (profile.Map is { } map)
    {
        <partial name="_LocationMap" model="map" />
    }
    <partial name="_SourceNote" model="profile.RegistrySource" />
    @if (fiscalEdition is not null)
    {
        <partial name="_SourceNote" model="fiscalEdition" />
    }
    @if (profile.Map is { } mapSource)
    {
        <partial name="_SourceNote" model="mapSource.Source" />
    }
</section>

@if (profile.Anaf is { } anaf)
{
    <section id="anaf" class="md-card md-card--outlined profile-section" aria-labelledby="anaf-title">
        <h2 id="anaf-title" class="md-card__title">Situația la ANAF</h2>
        @if (!anaf.Found)
        {
            <p class="md-typescale-body-medium md-missing">ANAF nu a găsit acest CUI la @CompanyModel.Date(anaf.CheckedOn).</p>
        }
        else
        {
            <dl class="md-facts">
                <div><dt>Plătitor de TVA</dt><dd>@CompanyModel.YesNo(anaf.VatPayer)</dd></div>
                <div><dt>TVA la încasare</dt><dd>@CompanyModel.YesNo(anaf.CashAccountingVat, anaf.CashAccountingVatSince)</dd></div>
                <div><dt>Plată defalcată a TVA</dt><dd>@CompanyModel.YesNo(anaf.SplitVat)</dd></div>
                <div><dt>Contribuabil inactiv</dt><dd>@CompanyModel.YesNo(anaf.Inactive, anaf.InactiveSince)@if (anaf.ReactivatedOn is { } reactivated) {<span class="md-on-surface-variant">, reactivat la @CompanyModel.Date(reactivated)</span>}</dd></div>
                <div><dt>Înregistrat în RO e-Factura</dt><dd>@CompanyModel.YesNo(anaf.EInvoice, anaf.EInvoiceSince)</dd></div>
                <div><dt>Stare la ANAF</dt><dd>@(anaf.RegistrationStatus ?? "—")</dd></div>
                <div class="md-facts__wide"><dt>Organ fiscal competent</dt><dd>@(anaf.TaxOffice ?? "—")@if (CompanyModel.TaxpayerCategory(anaf.TaxOffice) is { } category) {<span class="md-status md-status--active md-facts__badge">@category</span>}</dd></div>
                @if (anaf.DeregisteredOn is { } deregistered) { <div><dt>Radiat la ANAF</dt><dd>@CompanyModel.Date(deregistered)</dd></div> }
            </dl>
        }
        <p class="md-source">Sursa: Agenția Națională de Administrare Fiscală, serviciul web „PlatitorTvaRest” v9, interogat pentru data de @CompanyModel.Date(anaf.CheckedOn). Se păstrează doar stările fiscale, nu adresa, telefonul sau contul bancar.</p>
    </section>
}

@if (profile.RiskBuild is { } riskBuild)
{
    <section id="semnale" class="md-card md-card--outlined profile-section" aria-labelledby="semnale-title">
        <h2 id="semnale-title" class="md-card__title">Semnale de atenție</h2>
        @if (company.Cui is null || company.Lifecycle == BusinessIntelligence.Modules.Registry.Onrc.Lifecycle.StruckOff)
        {
            <p class="md-typescale-body-medium md-missing">Nu se calculează semnale pentru firmele radiate sau fără CUI valid.</p>
        }
        else if (profile.Signals.Count == 0)
        {
            <p class="md-typescale-body-medium">Niciun semnal din datele verificate.</p>
        }
        else
        {
            <ul class="md-list signal-list">
                @foreach (var signal in profile.Signals.OrderBy(item => BusinessIntelligence.Modules.Risk.RiskSignals.All.ToList().FindIndex(definition => definition.Key == item.Signal)))
                {
                    var definition = BusinessIntelligence.Modules.Risk.RiskSignals.Get(signal.Signal);
                    <li class="md-list__item md-list__item--dense">
                        <md-icon name="info" />
                        <span class="md-list__text">
                            <span class="md-list__headline">@definition.Name</span>
                            <span class="md-list__supporting">@CompanyModel.SignalDetail(signal) Sursa: @definition.Source.</span>
                        </span>
                    </li>
                }
            </ul>
        }
        <p class="md-typescale-body-small md-on-surface-variant">Semnalele sunt fapte din datele publice, nu un rating: lipsa lor nu înseamnă lipsa riscului. Starea ANAF este cea din ultimul răspuns al serviciului web; datele financiare sunt cele publicate de MF pentru @(riskBuild.FinancialYear?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—"). Stările din registru (insolvență, dizolvare) apar în Prezentare. Reguli @riskBuild.Version.</p>
    </section>
}

<section id="contact" class="md-card md-card--outlined profile-section" aria-labelledby="contact-title">
    <h2 id="contact-title" class="md-card__title">Contact</h2>
    <dl class="md-facts">
        <div><dt>Telefon</dt><dd>@(fiscal?.Phone ?? (Model.Individual ? "nu se afișează pentru persoane fizice" : "nedeclarat"))</dd></div>
        <div><dt>Fax</dt><dd>@(fiscal?.Fax ?? (Model.Individual ? "nu se afișează pentru persoane fizice" : "nedeclarat"))</dd></div>
        <div><dt>Site web</dt><dd>@if (current?.Website is { } website) { if (WebsiteUrl(website) is { } url) { <a href="@url" rel="nofollow noopener">@website</a> } else { @website } } else { <span class="md-missing">nedeclarat</span> }</dd></div>
        <div class="md-facts__wide"><dt>Domiciliu fiscal</dt><dd>@(fiscal is null ? "nu apare în datele de identificare MF" : FiscalAddress(fiscal))</dd></div>
    </dl>
    @if (Model.Individual)
    {
        <p class="md-typescale-body-small md-on-surface-variant">Pentru persoane fizice autorizate, întreprinderi individuale și familiale nu se păstrează strada, telefonul și faxul.</p>
    }
    @if (fiscalEdition is not null)
    {
        <partial name="_SourceNote" model="fiscalEdition" />
    }
    <partial name="_SourceNote" model="websiteSource" />
</section>

<section id="persoane" class="md-card md-card--outlined profile-section" aria-labelledby="persoane-title">
    <h2 id="persoane-title" class="md-card__title">Persoane</h2>
    @if (profile.People.Count == 0)
    {
        <p class="md-typescale-body-medium md-missing">Registrul nu listează administratori sau reprezentanți pentru această înregistrare.</p>
    }
    else
    {
        var severalRegistrations = profile.People.Select(item => item.RegistrationNumber).Distinct().Count() > 1;
        <div class="md-table-wrapper">
            <table class="md-data-table">
                <caption class="md-visually-hidden">Administratori și reprezentanți</caption>
                <thead><tr><th scope="col">Nume</th><th scope="col">Calitate</th><th scope="col">Născut(ă) / sediu</th>@if (severalRegistrations) {<th scope="col">Nr. înregistrare</th>}<th scope="col">Alte firme</th></tr></thead>
                <tbody>
                    @foreach (var person in profile.People)
                    {
                        <tr>
                            <td>@(person.Name ?? "—")</td>
                            <td>@(person.Role ?? "—")</td>
                            <td class="md-numeric">@(person.Kind switch
                            {
                                "natural" => person.BirthYear?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—",
                                "legal" => string.IsNullOrEmpty(person.Place) ? "persoană juridică" : person.Place,
                                _ => "—",
                            })</td>
                            @if (severalRegistrations) {<td>@person.RegistrationNumber</td>}
                            <td>
                                @if (person.OtherCount == 0)
                                {
                                    <span class="md-on-surface-variant">—</span>
                                }
                                else
                                {
                                    <details class="person-links">
                                        <summary>@(person.OtherCount == 1 ? "1 firmă" : $"{person.OtherCount.ToString("N0", ro)} firme")</summary>
                                        <ul>
                                            @foreach (var other in person.Others)
                                            {
                                                <li><a href="@(other.Cui is { } otherCui ? Url.Page("/Company", new { cui = otherCui }) : Url.Page("/Company", new { nr = other.RegistrationNumber }))">@(other.Name ?? other.RegistrationNumber)</a>@if (other.Lifecycle is { } state && state != BusinessIntelligence.Modules.Registry.Onrc.Lifecycle.Active) {<span class="md-on-surface-variant"> · @Model.Lifecycle(state).ToLowerInvariant()</span>}@if (!string.IsNullOrEmpty(other.Role)) {<span class="md-on-surface-variant"> · @other.Role</span>}</li>
                                            }
                                        </ul>
                                        @if (person.OtherCount > person.Others.Count)
                                        {
                                            <p class="md-typescale-body-small md-on-surface-variant">și încă @((person.OtherCount - person.Others.Count).ToString("N0", ro)); sunt afișate întâi cele active.</p>
                                        }
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="md-typescale-body-small md-on-surface-variant">Pentru persoanele fizice se afișează doar numele, calitatea și anul nașterii. „Alte firme” leagă înregistrările unde registrul are același nume, aceeași dată și același loc de naștere (pentru firme: aceeași denumire). Registrul nu are un identificator personal, deci legătura poate uni persoane diferite cu aceleași date sau poate omite aceeași persoană scrisă altfel. Asociații și beneficiarii reali nu sunt publicați de ONRC ca date deschise.</p>
    <partial name="_SourceNote" model="peopleSource" />
</section>

<section id="activitati" class="md-card md-card--outlined profile-section" aria-labelledby="activitati-title">
    <h2 id="activitati-title" class="md-card__title">Activități</h2>
    @if (latestStatement?.Statement?.CaenCode is { } mainCode)
    {
        <p class="md-typescale-body-large">Activitate principală declarată în situațiile financiare @latestStatement.Year:
            <strong><span class="md-caen-code">@mainCode</span> @(latestStatement.CaenName ?? "")</strong>
            @if (latestStatement.Statement.CaenVersion is null) { <span class="md-on-surface-variant">(versiunea CAEN nu este precizată în sursă)</span> }
        </p>
    }
    @if (profile.Activities.Count == 0)
    {
        <p class="md-typescale-body-medium md-missing">Registrul nu listează activități autorizate.</p>
    }
    else
    {
        var shown = 12;
        <h3 class="md-typescale-title-small">@profile.Activities.Count activități autorizate (CAEN Rev.@profile.Activities[0].Version)</h3>
        <ul class="md-list activity-list">
            @foreach (var activity in profile.Activities.Take(shown))
            {
                <li class="md-list__item md-list__item--dense"><span class="md-list__leading md-caen-code">@activity.Code</span><span class="md-list__text"><span class="md-list__headline">@(activity.Name ?? "cod fără denumire în nomenclator")</span></span></li>
            }
        </ul>
        @if (profile.Activities.Count > shown)
        {
            <details class="facet__more">
                <summary>Toate activitățile (@profile.Activities.Count)</summary>
                <ul class="md-list activity-list">
                    @foreach (var activity in profile.Activities.Skip(shown))
                    {
                        <li class="md-list__item md-list__item--dense"><span class="md-list__leading md-caen-code">@activity.Code</span><span class="md-list__text"><span class="md-list__headline">@(activity.Name ?? "cod fără denumire în nomenclator")</span></span></li>
                    }
                </ul>
            </details>
        }
    }
    <partial name="_SourceNote" model="profile.RegistrySource" />
</section>

@if (profile.Procurement is { } procurement)
{
    <section id="achizitii" class="md-card md-card--outlined profile-section" aria-labelledby="achizitii-title">
        <h2 id="achizitii-title" class="md-card__title">Achiziții publice</h2>
        <p class="md-typescale-body-small md-on-surface-variant">Contracte și achiziții directe publicate în SEAP; perioade importate: @procurement.Coverage. Lipsa unei firme din listă nu înseamnă că nu a avut contracte în afara acestor perioade.</p>
        <h3 class="md-typescale-title-small">Ca furnizor câștigător</h3>
        @if (procurement.Won.Count == 0)
        {
            <p class="md-typescale-body-medium md-missing">Niciun contract sau achiziție directă câștigată în perioadele importate.</p>
        }
        else
        {
            <partial name="_ProcurementYears" model="procurement.Won" />
            <p class="md-typescale-body-small md-on-surface-variant">Valorile sunt cele publicate în SEAP, fără corecții; câteva contracte au în sursă valori vădit eronate. Valoarea unui contract cu mai mulți câștigători este cea totală a contractului: sursa nu arată partea fiecăruia. Un contract publicat în mai multe trimestre este numărat o singură dată.</p>
            <div class="md-table-wrapper">
                <table class="md-data-table">
                    <caption>Cele mai recente @procurement.RecentWins.Count</caption>
                    <thead><tr><th scope="col">Data</th><th scope="col">Autoritate contractantă</th><th scope="col">Obiect</th><th scope="col">Tip</th><th scope="col" class="md-numeric">Valoare (lei)</th></tr></thead>
                    <tbody>
                        @foreach (var award in procurement.RecentWins)
                        {
                            <tr>
                                <td class="md-numeric">@CompanyModel.Date(award.ContractDate ?? award.PublishedOn)</td>
                                <td>@(award.AuthorityName ?? "—")</td>
                                <td>@(award.Title ?? award.CpvName ?? "—")@if (award.CpvCode is { } cpv) {<span class="md-on-surface-variant"> · CPV @cpv</span>}</td>
                                <td>@(award.Kind == "direct" ? "achiziție directă" : "contract")@if (award.Winners > 1) {<span class="md-on-surface-variant"> · @award.Winners câștigători</span>}</td>
                                <td class="md-numeric">@(award.ValueRon is { } value ? value.ToString("N2", CompanyModel.Ro) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (procurement.Bought.Count > 0)
        {
            <h3 class="md-typescale-title-small">Ca autoritate contractantă</h3>
            <partial name="_ProcurementYears" model="procurement.Bought" />
        }
        @foreach (var source in procurement.Sources)
        {
            <partial name="_SourceNote" model="source" />
        }
    </section>
}

@if (profile.FundSources.Count > 0)
{
    <section id="fonduri" class="md-card md-card--outlined profile-section" aria-labelledby="fonduri-title">
        <h2 id="fonduri-title" class="md-card__title">Fonduri europene</h2>
        @if (profile.Funds.Count == 0)
        {
            <p class="md-typescale-body-medium md-missing">Niciun proiect în listele importate.</p>
        }
        else
        {
            <div class="md-table-wrapper">
                <table class="md-data-table">
                    <caption class="md-visually-hidden">Proiecte cu finanțare europeană</caption>
                    <thead><tr><th scope="col">Program</th><th scope="col">Proiect</th><th scope="col">Stare</th><th scope="col">Perioada</th><th scope="col" class="md-numeric">Valoare (lei)</th><th scope="col" class="md-numeric">Plătit (lei)</th><th scope="col">Legătură</th></tr></thead>
                    <tbody>
                        @foreach (var entry in profile.Funds)
                        {
                            var project = entry.Project;
                            var value = project.TotalValue ?? project.EligibleValue ?? project.ContractedValue;
                            <tr>
                                <td>@project.Programme</td>
                                <td>@(project.Title ?? "—")@if (project.ProjectCode is { } code) {<span class="md-on-surface-variant"> · @code</span>}</td>
                                <td>@(project.Status ?? "—")</td>
                                <td class="md-numeric">@(project.StartDate is null && project.EndDate is null ? "—" : $"{CompanyModel.Date(project.StartDate)} – {CompanyModel.Date(project.EndDate)}")</td>
                                <td class="md-numeric">@(value is { } amount ? amount.ToString("N2", CompanyModel.Ro) : "—")</td>
                                <td class="md-numeric">@(project.PaidValue is { } paid ? paid.ToString("N2", CompanyModel.Ro) : "—")</td>
                                <td>@(entry.ByName ? "după denumire și județ" : "după CUI")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p class="md-typescale-body-small md-on-surface-variant">Listele ministerului și lista AFIR 2014–2020 nu dau codul fiscal al beneficiarului: un proiect este atribuit firmei când denumirea este identică și nicio altă firmă din același județ nu are această denumire. Proiectele în parteneriat (POCU) nu pot fi atribuite așa. Valoarea este totalul proiectului, valoarea eligibilă sau cea contractată, după ce publică fiecare listă.</p>
        @foreach (var source in profile.FundSources)
        {
            <partial name="_SourceNote" model="source" />
        }
    </section>
}

@if (profile.Licences.Count > 0)
{
    <section id="licente" class="md-card md-card--outlined profile-section" aria-labelledby="licente-title">
        <h2 id="licente-title" class="md-card__title">Licențe și contracte cu autorități</h2>
        <div class="md-table-wrapper">
            <table class="md-data-table">
                <caption class="md-visually-hidden">Licențe, autorizații și contracte</caption>
                <thead><tr><th scope="col">Autoritate</th><th scope="col">Stare</th><th scope="col">Activitate</th><th scope="col">Detalii</th><th scope="col">Loc</th><th scope="col">Sursa</th></tr></thead>
                <tbody>
                    @foreach (var entry in profile.Licences)
                    {
                        var licence = entry.Licence;
                        <tr>
                            <td>@licence.Authority</td>
                            <td>@licence.Status</td>
                            <td>@(licence.Activity ?? "—")</td>
                            <td>@(licence.Details ?? "—")</td>
                            <td>@(licence.Place ?? "—")</td>
                            <td>@entry.Source@if (entry.ByName) {<span class="md-on-surface-variant"> · legat după denumire</span>}</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="md-typescale-body-small md-on-surface-variant">ANRSC: licențe pentru servicii de utilități publice (valabile, retrase, respinse). ANRM: licențe miniere active, legate de firmă numai când denumirea titularului este identică și unică. CNAS: contracte cu furnizori de servicii medicale și farmacii.</p>
        @foreach (var source in profile.LicenceSources)
        {
            <partial name="_SourceNote" model="source" />
        }
    </section>
}

<section id="istoric" class="md-card md-card--outlined profile-section" aria-labelledby="istoric-title">
    <h2 id="istoric-title" class="md-card__title">Istoric</h2>
    <p class="md-typescale-body-small md-on-surface-variant">Fiecare rând este o perioadă în care datele au rămas la fel, între datele publicațiilor. Schimbările dintre două publicații apar la publicația următoare.</p>
    <h3 class="md-typescale-title-small">Registrul Comerțului</h3>
    @if (profile.RegistryHistory.Count == 0)
    {
        <p class="md-typescale-body-medium md-missing">Nu apare în instantaneele anterioare ale registrului.</p>
    }
    else
    {
        <div class="md-table-wrapper">
            <table class="md-data-table">
                <thead><tr><th scope="col">Perioada</th><th scope="col">Nr. înregistrare</th><th scope="col">Denumire</th><th scope="col">Localitate</th><th scope="col">Stare</th></tr></thead>
                <tbody>
                    @foreach (var period in profile.RegistryHistory.Reverse())
                    {
                        <tr>
                            <td class="md-numeric">@CompanyModel.Date(period.ValidFrom) – @CompanyModel.Date(period.ValidTo)</td>
                            <td>@period.RegistrationNumber</td>
                            <td>@period.Name</td>
                            <td>@(Model.Place(period.LocalityCode ?? period.UatCode) ?? period.Locality)@(Model.County(period.CountyNumber) is { } periodCounty ? $", {periodCounty}" : "")</td>
                            <td>@Model.Lifecycle(period.Lifecycle)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (profile.HistorySource is { } historySource) { <partial name="_SourceNote" model="historySource" /> }
    }

    <h3 class="md-typescale-title-small">Date fiscale (MF)</h3>
    @if (profile.FiscalHistory.Count == 0)
    {
        <p class="md-typescale-body-medium md-missing">Nu apare în datele de identificare MF.</p>
    }
    else
    {
        <div class="md-table-wrapper">
            <table class="md-data-table">
                <thead><tr><th scope="col">Perioada</th><th scope="col">Denumire</th><th scope="col">Localitate</th><th scope="col">TVA</th><th scope="col">Stare fiscală</th><th scope="col">Obligații declarate</th></tr></thead>
                <tbody>
                    @foreach (var period in profile.FiscalHistory.Reverse())
                    {
                        <tr>
                            <td class="md-numeric">@CompanyModel.Date(period.ValidFrom) – @CompanyModel.Date(period.ValidTo)</td>
                            <td>@period.Name</td>
                            <td>@string.Join(", ", new[] { period.Locality, period.County }.Where(item => !string.IsNullOrEmpty(item)))</td>
                            <td>@(period.VatPayer switch { true => "Da", false => "Nu", null => "—" })</td>
                            <td>@(period.FiscalStatus ?? "—")</td>
                            <td>@(period.Obligations.Length == 0 ? "—" : string.Join(", ", period.Obligations.Select(code => CompanyModel.Obligations.TryGetValue(code, out var name) ? $"{code} {name}" : code.ToString(System.Globalization.CultureInfo.InvariantCulture))))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (profile.FiscalSource is { } fiscalHistorySource) { <partial name="_SourceNote" model="fiscalHistorySource" /> }
    }
</section>

<section id="financiar" class="md-card md-card--outlined profile-section" aria-labelledby="financiar-title">
    <h2 id="financiar-title" class="md-card__title">Financiar</h2>
    @if (company.Cui is null)
    {
        <p class="md-typescale-body-medium md-missing">Fără CUI valid, situațiile financiare nu pot fi legate de această înregistrare.</p>
    }
    else if (filed.Count == 0)
    {
        <p class="md-typescale-body-medium md-missing">Nicio situație financiară depusă în @(profile.Financials.FirstOrDefault()?.Year)–@(profile.Financials.LastOrDefault()?.Year).</p>
    }
    else
    {
        <p class="md-typescale-body-small md-on-surface-variant">Sume în lei, așa cum au fost publicate. „nedepus” = nicio situație pentru acel an; „—” = câmp necompletat în situația depusă; niciuna nu înseamnă zero. În grafice, o liniuță gri marchează anii fără valoare.</p>
        <div class="chart-grid">
            @foreach (var chart in Model.Charts())
            {
                <partial name="_BarChart" model="chart" />
            }
        </div>
        <div class="md-table-wrapper">
            <table class="md-data-table">
                <caption>Indicatori principali</caption>
                <thead><tr><th scope="col">An</th><th scope="col" class="md-numeric">Cifra de afaceri</th><th scope="col" class="md-numeric">Profit net</th><th scope="col" class="md-numeric">Pierdere netă</th><th scope="col" class="md-numeric">Salariați</th><th scope="col" class="md-numeric">Capitaluri proprii</th><th scope="col" class="md-numeric">Datorii</th><th scope="col">Formular</th></tr></thead>
                <tbody>
                    @foreach (var year in profile.Financials.Reverse())
                    {
                        <tr>
                            <th scope="row" class="md-numeric">@year.Year</th>
                            @if (year.Statement is not { } statement)
                            {
                                <td colspan="7" class="md-missing">nedepus</td>
                            }
                            else
                            {
                                <td class="md-numeric">@Cell(statement.Turnover)</td>
                                <td class="md-numeric">@Cell(statement.NetProfit)</td>
                                <td class="md-numeric">@Cell(statement.NetLoss)</td>
                                <td class="md-numeric">@Cell(statement.Employees)</td>
                                <td class="md-numeric">@Cell(statement.Equity)</td>
                                <td class="md-numeric">@Cell(statement.Liabilities)</td>
                                <td>@statement.Family@if (statement.QualityFlags.Length > 0) {<span class="md-on-surface-variant"> · valoare imposibilă în sursă, lăsată necompletată</span>}</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <details class="facet__more">
            <summary>Toți indicatorii publicați</summary>
            <div class="md-table-wrapper">
                <table class="md-data-table md-data-table--sticky-first">
                    <thead><tr><th scope="col">Indicator</th>@foreach (var year in filed.AsEnumerable().Reverse()) { <th scope="col" class="md-numeric">@year.Year</th> }</tr></thead>
                    <tbody>
                        @foreach (var (label, value) in CompanyModel.Indicators)
                        {
                            <tr><th scope="row">@label</th>@foreach (var year in filed.AsEnumerable().Reverse()) { <td class="md-numeric">@Cell(value(year.Statement!))</td> }</tr>
                        }
                        <tr><th scope="row">Număr mediu de salariați</th>@foreach (var year in filed.AsEnumerable().Reverse()) { <td class="md-numeric">@Cell(year.Statement!.Employees)</td> }</tr>
                    </tbody>
                </table>
            </div>
        </details>
        <h3 id="indicatori-title" class="md-typescale-title-small">Indicatori calculați</h3>
        <div class="md-table-wrapper">
            <table class="md-data-table md-data-table--sticky-first" aria-labelledby="indicatori-title">
                <thead><tr><th scope="col">Indicator</th>@foreach (var year in filed.AsEnumerable().Reverse()) { <th scope="col" class="md-numeric">@year.Year</th> }</tr></thead>
                <tbody>
                    @{ var derived = filed.ToDictionary(year => year.Year, Model.Derived); }
                    @for (var index = 0; index < FinancialIndicators.All.Count; index++)
                    {
                        var indicator = FinancialIndicators.All[index];
                        <tr><th scope="row">@indicator.Name</th>@foreach (var year in filed.AsEnumerable().Reverse()) { <td class="md-numeric">@Derived(indicator, derived[year.Year][index])</td> }</tr>
                    }
                </tbody>
            </table>
        </div>
        @if (profile.Comparison is { } comparison)
        {
            <h3 id="comparatie-title" class="md-typescale-title-small">Comparație cu firmele din aceeași clasă CAEN, @comparison.Year</h3>
            <p class="md-typescale-body-medium">
                CAEN Rev.@comparison.CaenVersion @comparison.CaenCode@(comparison.CaenName is { } caenName ? " – " + caenName : "")@(comparison.SizeBand is { } band ? $"; mărimea firmei: {CompanyModel.SizeLabel(band)}" : "").
                @if (filed[^1].Year > comparison.Year)
                {
                    <span class="md-on-surface-variant">Pentru @filed[^1].Year sursa amestecă coduri CAEN Rev.2 și Rev.3, așa că nu se poate stabili clasa fiecărei firme; comparația folosește @comparison.Year.</span>
                }
            </p>
            <div class="md-table-wrapper">
                <table class="md-data-table md-data-table--sticky-first" aria-labelledby="comparatie-title">
                    <thead><tr><th scope="col">Indicator</th><th scope="col" class="md-numeric">Firma</th><th scope="col" class="md-numeric">Mediana</th><th scope="col" class="md-numeric">Jumătatea de mijloc</th><th scope="col">Poziția firmei</th><th scope="col">Comparat cu</th></tr></thead>
                    <tbody>
                        @foreach (var row in comparison.Rows)
                        {
                            var cohort = row.Cohort;
                            <tr>
                                <th scope="row">@row.Indicator.Name</th>
                                <td class="md-numeric">@Derived(row.Indicator, row.Value, visibleReason: true)</td>
                                @if (cohort is not { P50: { } median })
                                {
                                    <td colspan="3" class="md-missing">prea puține firme pentru o comparație</td>
                                }
                                else
                                {
                                    <td class="md-numeric">@CompanyModel.Indicator(row.Indicator, median)</td>
                                    <td class="md-numeric">de la @CompanyModel.Indicator(row.Indicator, cohort.P25!.Value) la @CompanyModel.Indicator(row.Indicator, cohort.P75!.Value)</td>
                                    <td>@(row.Value.Value is { } own ? CompanyModel.Position(own, cohort) : "—")</td>
                                }
                                <td>@(cohort is null ? "—" : $"{CompanyModel.Amount(cohort.Population)} firme, {CompanyModel.SizeLabel(cohort.SizeBand)}")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="md-typescale-body-small md-on-surface-variant">Mediana împarte firmele în două jumătăți egale; jumătatea de mijloc cuprinde firmele dintre percentilele 25 și 75. Se compară firmele cu aceeași mărime când sunt cel puțin @BuildFinancialBenchmarks.MinimumPopulation, altfel toate firmele din clasă. Poziția nu este o apreciere: o valoare mare poate fi bună (marja) sau un risc (îndatorarea).</p>
        }
        <details class="facet__more">
            <summary>Cum se calculează indicatorii</summary>
            <dl class="md-facts">
                @foreach (var indicator in FinancialIndicators.All)
                {
                    <div class="md-facts__wide"><dt>@indicator.Name</dt><dd>@indicator.Formula</dd></div>
                }
            </dl>
            <p class="md-typescale-body-small md-on-surface-variant">Rezultatul net este profitul net publicat sau, cu minus, pierderea netă. Un câmp necompletat nu este citit ca zero: indicatorul rămâne necalculat, cu motivul afișat. Formule @FinancialIndicators.Version.</p>
        </details>
        <p class="md-source">Sursa: Ministerul Finanțelor, situațiile financiare anuale publicate pe data.gov.ro; fișierul și licența fiecărui an:</p>
        <ul class="source-list">
            @foreach (var year in filed.AsEnumerable().Reverse().Where(item => item.Source is not null))
            {
                var source = year.Source!;
                <li>@year.Year: @source.Publisher, „@source.Dataset”, <a href="@source.Url" rel="noopener">@source.FileName</a>, @source.License</li>
            }
        </ul>
    }
</section>
</div>

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent Cell(decimal? value) => value is { } present
        ? new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(CompanyModel.Amount(present)))
        : new Microsoft.AspNetCore.Html.HtmlString("<span class=\"md-missing\" title=\"necompletat\">—<span class=\"md-visually-hidden\"> necompletat</span></span>");

    private static Microsoft.AspNetCore.Html.IHtmlContent Cell(int? value) => Cell((decimal?)value);

    /// <summary>A derived value, or a dash whose reason is read by screen readers and shown on hover (or in full when <paramref name="visibleReason"/>).</summary>
    private static Microsoft.AspNetCore.Html.IHtmlContent Derived(IndicatorDefinition indicator, IndicatorValue value, bool visibleReason = false) => value.Value is { } present
        ? new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(CompanyModel.Indicator(indicator, present)))
        : visibleReason ? new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"md-missing\">{System.Net.WebUtility.HtmlEncode(value.Reason)}</span>")
        : new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"md-missing\" title=\"{System.Net.WebUtility.HtmlEncode(value.Reason)}\">—<span class=\"md-visually-hidden\"> {System.Net.WebUtility.HtmlEncode(value.Reason)}</span></span>");

    private string AddressText(BusinessIntelligence.Modules.Registry.Registration? registration)
    {
        if (registration is null)
        {
            return "—";
        }

        var street = string.Join(" ", new[] { registration.Street, registration.StreetNumber is { } number ? "nr. " + number : null }.Where(item => !string.IsNullOrWhiteSpace(item)));
        var building = string.Join(", ", new[] {
            registration.Block is { Length: > 0 } block ? "bl. " + block : null, registration.Staircase is { Length: > 0 } stair ? "sc. " + stair : null,
            registration.Floor is { Length: > 0 } floor ? "et. " + floor : null, registration.Apartment is { Length: > 0 } apartment ? "ap. " + apartment : null }.Where(item => item is not null));
        var parts = new[] { street, building, registration.AddressDetails, registration.Sector is { Length: > 0 } sector && sector != "0" ? "sector " + sector : null,
            Model.Place(registration.LocalityCode ?? registration.UatCode) ?? registration.Locality, Model.County(registration.CountyNumber) ?? registration.County,
            registration.PostalCode is { Length: > 0 } postal ? "cod poștal " + postal : null };
        return string.Join(", ", parts.Where(item => !string.IsNullOrWhiteSpace(item)));
    }

    private static string FiscalAddress(BusinessIntelligence.Modules.Fiscal.TaxpayerPeriod period)
    {
        var parts = new[] { period.Street is { } street ? street + (period.StreetNumber is { } number ? " nr. " + number : "") : null,
            period.Block is { Length: > 0 } block ? "bl. " + block : null, period.Apartment is { Length: > 0 } apartment ? "ap. " + apartment : null,
            period.AddressDetails, period.Sector is { Length: > 0 } sector && sector != "0" ? "sector " + sector : null, period.Locality, period.County,
            period.PostalCode is { Length: > 0 } postal ? "cod poștal " + postal : null };
        return string.Join(", ", parts.Where(item => !string.IsNullOrWhiteSpace(item)));
    }

    /// <summary>Registry websites are free text; only plain host names become links, always over https.</summary>
    private static string? WebsiteUrl(string website)
    {
        var host = website.Trim();
        foreach (var prefix in new[] { "https://", "http://" })
        {
            if (host.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) { host = host[prefix.Length..]; }
        }

        host = host.TrimEnd('/');
        return System.Text.RegularExpressions.Regex.IsMatch(host, @"^[A-Za-z0-9.-]+\.[A-Za-z]{2,}(/[A-Za-z0-9._~/-]*)?$") ? "https://" + host : null;
    }
}
