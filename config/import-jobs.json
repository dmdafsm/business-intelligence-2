{
  "timeZone": "Europe/Bucharest",
  "ckanApi": "https://data.gov.ro/api/3/action/",
  "allowedHosts": ["data.gov.ro"],
  "maxFileBytes": 4294967296,
  "jobs": [
    {
      "id": "onrc",
      "title": "Registrul comerțului (ONRC), instantaneu lunar",
      "schedule": "30 7 * * *",
      "discover": [
        {
          "organization": "onrc",
          "dataset": "^Firme .nregistrate la Registrul Comer.ului p.n. la data de (?<day>\\d{2})\\.(?<month>\\d{2})\\.(?<year>\\d{4})$",
          "maxDatasets": 3,
          "wholeDataset": true,
          "referenceDate": "{year}-{month}-{day}",
          "files": [
            { "kind": "onrc-firme", "resource": "^OD_FIRME\\.CSV$", "id": "onrc-firme-{year}-{month}-{day}", "path": "onrc-{year}-{month}-{day}/OD_FIRME.CSV" },
            { "kind": "onrc-firme-status", "resource": "^OD_STARE_FIRMA\\.CSV$", "id": "onrc-stare-firma-{year}-{month}-{day}", "path": "onrc-{year}-{month}-{day}/OD_STARE_FIRMA.CSV" },
            { "kind": "onrc-firme-activities", "resource": "^OD_CAEN_AUTORIZAT\\.CSV$", "id": "onrc-caen-autorizat-{year}-{month}-{day}", "path": "onrc-{year}-{month}-{day}/OD_CAEN_AUTORIZAT.CSV" },
            { "kind": "onrc-firme-representatives", "resource": "^OD_REPREZENTANTI_LEGALI\\.CSV$", "id": "onrc-reprezentanti-legali-{year}-{month}-{day}", "path": "onrc-{year}-{month}-{day}/OD_REPREZENTANTI_LEGALI.CSV" },
            { "kind": "onrc-firme-family-members", "resource": "^OD_REPREZENTANTI_IF\\.CSV$", "id": "onrc-reprezentanti-if-{year}-{month}-{day}", "path": "onrc-{year}-{month}-{day}/OD_REPREZENTANTI_IF.CSV" }
          ]
        },
        {
          "organization": "onrc",
          "dataset": "^Nomenclatoare utilizate .n decodificarea .* - (?<day>\\d{2})\\.(?<month>\\d{2})\\.(?<year>\\d{4})$",
          "maxDatasets": 3,
          "wholeDataset": true,
          "referenceDate": "{year}-{month}-{day}",
          "files": [
            { "kind": "onrc-caen", "resource": "^N_CAEN\\.CSV$", "id": "onrc-n-caen-{year}-{month}-{day}", "path": "onrc-{year}-{month}-{day}/N_CAEN.CSV" },
            { "kind": "onrc-status", "resource": "^N_STARE_FIRMA\\.CSV$", "id": "onrc-n-stare-firma-{year}-{month}-{day}", "path": "onrc-{year}-{month}-{day}/N_STARE_FIRMA.CSV" }
          ]
        }
      ],
      "commands": [
        ["registry", "import", "{latest-id:onrc-caen}", "{latest-path:onrc-caen}"],
        ["registry", "import", "{latest-id:onrc-status}", "{latest-path:onrc-status}"],
        ["registry", "import", "{latest-id:onrc-firme}", "{latest-path:onrc-firme}"],
        ["registry", "import", "{latest-id:onrc-firme-status}", "{latest-path:onrc-firme-status}"],
        ["registry", "import", "{latest-id:onrc-firme-activities}", "{latest-path:onrc-firme-activities}"],
        ["registry", "import", "{latest-id:onrc-firme-representatives}", "{latest-path:onrc-firme-representatives}"],
        ["registry", "import", "{latest-id:onrc-firme-family-members}", "{latest-path:onrc-firme-family-members}"],
        ["registry", "history", "{raw}"],
        ["search", "build"],
        ["market", "build"]
      ]
    },
    {
      "id": "mf-identification",
      "title": "Date de identificare plătitori (MF)",
      "schedule": "0 8 * * 1",
      "discover": [
        {
          "organization": "mfp",
          "dataset": "^Date de identificare pl.titori actualizate [a-zăâîșț]+ (?<year>\\d{4})$",
          "maxDatasets": 2,
          "wholeDataset": true,
          "referenceDate": "{datasetModified}",
          "year": "{year}",
          "files": [
            { "kind": "mf-identification", "resource": "\\.txt$", "id": "mf-id-{year}-{slug}", "path": "mf-identification/{year}/{file}" }
          ]
        }
      ],
      "commands": [["fiscal", "import-all", "{raw}"]]
    },
    {
      "id": "mf-financials",
      "title": "Situații financiare anuale (MF)",
      "schedule": "0 8 * * 2",
      "discover": [
        {
          "organization": "mfp",
          "dataset": "^Situa(t|ț)i(i|ile) financiare (?<year>\\d{4})$",
          "maxDatasets": 2,
          "wholeDataset": true,
          "referenceDate": "{yearEnd}",
          "year": "{year}",
          "family": "{family}",
          "map": { "family": { "BL_BS_SL": "BL", "UU": "UU", "IR": "IR" } },
          "files": [
            { "kind": "mf-financials-data", "resource": "^WEB_(?<family>BL_BS_SL|UU|IR)_AN\\d{4}\\.txt$", "id": "mf-{year}-{family}-data", "path": "mf-financials/{year}/{family}-data-{file}" },
            { "kind": "mf-financials-dictionary", "resource": "^WEB_(?<family>BL_BS_SL|UU|IR)_(AN)?\\d{4}\\.csv$", "id": "mf-{year}-{family}-dictionary", "path": "mf-financials/{year}/{family}-dict-{file}" }
          ]
        }
      ],
      "commands": [["financials", "import-all", "{raw}"]]
    },
    {
      "id": "seap",
      "title": "Achiziții publice (SEAP), trimestrial",
      "schedule": "0 9 * * 3",
      "discover": [
        {
          "organization": "agentia-pentru-agenda-digitala-a-romaniei",
          "dataset": "^Achizi(t|ț)ii publice (?<year>\\d{4})$",
          "maxDatasets": 2,
          "referenceDate": "{quarterEnd}",
          "year": "{year}",
          "family": "Q{quarter}",
          "map": { "quarter": { "I": "1", "II": "2", "III": "3", "IV": "4" } },
          "files": [
            { "kind": "seap-contracts", "resource": "^Contracte T\\s*(?<quarter>IV|III|II|I|[1-4])(\\s+\\d{4})?$", "id": "seap-contracts-{year}-q{quarter}", "path": "seap-history/{year}/{file}" },
            { "kind": "seap-direct", "resource": "^Achizi(t|ț)ii directe T\\s*(?<quarter>IV|III|II|I|[1-4])(\\s+\\d{4})?$", "id": "seap-direct-{year}-q{quarter}", "path": "seap-history/{year}/{file}" }
          ]
        }
      ],
      "commands": [["procurement", "import-all", "{raw}"]]
    },
    {
      "id": "eu-funds",
      "title": "Proiecte cu fonduri europene (MIPE)",
      "schedule": "0 9 1 * *",
      "discover": [
        {
          "organization": "mfe",
          "dataset": "^Proiecte contractate$",
          "maxDatasets": 1,
          "referenceDate": "{year}-{month}-{day}",
          "groupFromFile": "^([a-z]+)-",
          "map": {
            "month": { "ianuarie": "01", "februarie": "02", "martie": "03", "aprilie": "04", "mai": "05", "iunie": "06", "iulie": "07", "august": "08", "septembrie": "09", "octombrie": "10", "noiembrie": "11", "decembrie": "12" },
            "day": { "1": "01", "2": "02", "3": "03", "4": "04", "5": "05", "6": "06", "7": "07", "8": "08", "9": "09" }
          },
          "files": [
            { "kind": "eu-projects-mipe", "resource": "^[A-Z]+\\s*-\\s*Lista proiectelor contractate\\s*la\\s+(?<day>\\d{1,2})\\s+(?<month>[a-z]+)\\s+(?<year>\\d{4})", "file": "\\.xlsx$", "id": "eu-projects-mipe-{slug}", "path": "eu-funds/mipe/{file}" }
          ]
        }
      ],
      "commands": [["funds", "import-all", "{raw}"]]
    },
    {
      "id": "licences",
      "title": "Licențe ANRSC și furnizori CNAS",
      "schedule": "0 9 2 * *",
      "discover": [
        {
          "organization": "autoritatea-nationala-de-reglementare-pentru-serviciile-comunitare-de-utilitati-publice",
          "dataset": "^Evidenta licente A\\.N\\.R\\.S\\.C\\.$",
          "maxDatasets": 1,
          "referenceDate": "{year}-{month}-{day}",
          "groupFromFile": "^evidenta-licente-([a-z]+)",
          "files": [
            { "kind": "licences-anrsc", "resource": "^evidenta licente (valabile|retrase|respinse) (?<day>\\d{2})\\.(?<month>\\d{2})\\.(?<year>\\d{4})\\.csv$", "id": "licences-anrsc-{slug}", "path": "licences/anrsc/{file}" }
          ]
        },
        {
          "organization": "casa-nationala-de-asigurari-de-sanatate",
          "dataset": "^Lista furnizori$",
          "maxDatasets": 1,
          "referenceDate": "{year}-{month}-{day}",
          "groupFromFile": "^(contracte-.+?)-\\d",
          "files": [
            { "kind": "licences-cnas", "resource": "^Contracte .+ (?<day>\\d{2})\\.(?<month>\\d{2})\\.(?<year>\\d{4})(\\.xlsx?)?$", "file": "\\.xlsx?$", "id": "licences-cnas-{slug}", "path": "licences/cnas/{file}" }
          ]
        }
      ],
      "commands": [["licences", "import-all", "{raw}"]]
    },
    {
      "id": "anaf-status",
      "title": "Starea fiscală ANAF (serviciul web)",
      "schedule": "0 1 3 * *",
      "timeoutHours": 14,
      "commands": [["anaf", "harvest"]]
    }
  ]
}
